{
  "name": "darksouls-tome",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "convert-data": "node --experimental-strip-types scripts/convertXmlToJson.ts",
    "generate:dialogue-index": "node --experimental-strip-types scripts/generateDialogueIndex.ts",
    "validate:data": "node --experimental-strip-types scripts/validateData.ts",
    "test:build": "node --experimental-strip-types scripts/test-build.ts",
    "deploy": "npm run build && npm run test:build",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "vue": "^3.5.25",
    "xml2js": "^0.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "pinia": "^3.0.4",
    "prettier": "^3.9.6",
    "sass": "^1.97.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.0.0-beta.13",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.1.5"
  },
  "overrides": {
    "vite": "^8.0.0-beta.13"
  }
}
